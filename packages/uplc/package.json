{
  "name": "@lucid-evolution/uplc",
  "version": "0.5.3",
  "main": "./dist/speed/node.js",
  "browser": "./dist/size/browser/uplc_tx.js",
  "types": "./dist/speed/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/speed/node.d.ts",
      "workerd": "./dist/size/browser/uplc_tx.js",
      "edge-light": "./dist/size/browser/uplc_tx.js",
      "worker": "./dist/size/browser/uplc_tx.js",
      "browser": "./dist/size/browser/uplc_tx.js",
      "default": "./dist/speed/node.js"
    },
    "./speed": {
      "types": "./dist/speed/node.d.ts",
      "workerd": "./dist/speed/browser/uplc_tx.js",
      "edge-light": "./dist/speed/browser/uplc_tx.js",
      "worker": "./dist/speed/browser/uplc_tx.js",
      "browser": "./dist/speed/browser/uplc_tx.js",
      "default": "./dist/speed/node.js"
    },
    "./size": {
      "types": "./dist/size/node.d.ts",
      "workerd": "./dist/size/browser/uplc_tx.js",
      "edge-light": "./dist/size/browser/uplc_tx.js",
      "worker": "./dist/size/browser/uplc_tx.js",
      "browser": "./dist/size/browser/uplc_tx.js",
      "default": "./dist/size/node.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "speed": [
        "./dist/speed/node.d.ts"
      ],
      "size": [
        "./dist/size/node.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build-local": "rm -rf dist && cd rust && wasm-pack build --target bundler --out-dir ../src/speed/browser && wasm-pack build --profile release-size --target bundler --out-dir ../src/size/browser && cd .. && scripts/build-node.sh && pnpm clean-garbage",
    "build": "cp -r src dist",
    "clean-garbage": "for d in speed/browser speed/node size/browser size/node; do rm -f src/$d/.gitignore src/$d/package.json; done",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
