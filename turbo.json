{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@lucid-evolution/lucid#test": {
      "dependsOn": ["^build", "@lucid-evolution/provider#test"]
    }
  }
}
